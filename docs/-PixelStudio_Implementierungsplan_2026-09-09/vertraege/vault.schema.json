{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PixelStudio Vault-Metadaten",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "pixelStudioVault"
    },
    "vaultId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,127}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "vaultId",
    "createdAt"
  ]
}
